{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Lean: fetch mathlib cache",
      "type": "process",
      "command": "lake",
      "args": ["exe", "cache", "get"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Lean: build",
      "type": "process",
      "command": "lake",
      "args": ["build"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    },
    {
      "label": "Lean: verify proofs and axioms",
      "type": "process",
      "command": "python3",
      "args": ["verify.py"],
      "windows": {
        "command": "py",
        "args": ["-3", "verify.py"]
      },
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
